{
  "name": "wewin-practice",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tools/platform.test.mjs",
    "test:ui": "node --test tools/learning-ui.test.mjs",
    "test:client": "node --test tools/client-runtime.test.mjs",
    "migrate": "node --env-file-if-exists=.env.local tools/migrate.mjs",
    "dev": "node --env-file-if-exists=.env.local tools/platform-dev.mjs",
    "prepare:content": "python tools/prepare_platform.py",
    "prepare:starters": "python tools/prepare_starters_new.py",
    "prepare:movers-hard": "python tools/prepare_movers_hard.py",
    "prepare:flyers-hard": "python tools/prepare_flyers_hard.py",
    "prepare:images": "python tools/optimize_images.py",
    "test:media": "node tools/test-media.mjs",
    "test:starters": "node tools/test-starters.mjs",
    "test:movers-hard": "node tools/test-movers-hard.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14"
  }
}
