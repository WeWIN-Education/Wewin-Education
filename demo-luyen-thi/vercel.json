{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "headers": [
    {
      "source": "/analytics-frame.html",
      "headers": [
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'self'; sandbox allow-scripts"},
        {"key": "Referrer-Policy", "value": "no-referrer"}
      ]
    }
  ],
  "functions": {
    "api/practice.mjs": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/hub/exam-attempts.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/**,generated/**"
    }
  }
}
